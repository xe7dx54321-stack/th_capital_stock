  "blocked_sites": [
    {
      "hostname_pattern": "*guba.*",
      "reason": "股吧：匿名帖子不可信，可能含操纵性内容。",
      "block_type": "hard"
    },
    {
      "hostname_pattern": "*xueqiu.com",
      "reason": "社区UGC为主，权威等级不超过 discovery。默认软屏蔽，但允许在白名单覆盖下作为线索。",
      "block_type": "soft_discovery_only"
    },
    {
      "hostname_pattern": "*eastmoney.com",
      "reason": "门户财经+股吧混合，权威等级不超过 reputable_secondary。仅保留其公开新闻。",
      "block_type": "restrict_authority_to_reputable"
    },
    {
      "hostname_pattern": "*zhihu.com",
      "reason": "问答UGC，仅允许 discovery 级线索。",
      "block_type": "soft_discovery_only"
    },
    {
      "hostname_pattern": "*weibo.com",
      "reason": "社交UGC，仅允许 discovery 级线索。",
      "block_type": "soft_discovery_only"
    },
    {
      "hostname_pattern": "*baidu.com",
      "reason": "搜索引擎聚合页，不直接作为正文来源，仅用于发现 URL。",
      "block_type": "search_result_only"
    },
    {
      "hostname_pattern": "*pdf.dfcfw.com",
      "reason": "转载门户PDF文档，需检查是否有原始发布者链接再复用。",
      "block_type": "cross_verify_required"
    },
    {
      "hostname_pattern": "*toutiao.com",
      "reason": "自媒体/内容农场风险高，默认硬屏蔽。",
      "block_type": "hard"
    },
    {
      "hostname_pattern": "*163.com/dy/article/*",
      "reason": "网易号自媒体聚合，默认硬屏蔽。",
      "block_type": "hard"
    }
  ],
  "reputation_checks": {
    "minimum_text_length_chars": 400,
    "minimum_paragraphs": 3,
    "ads_to_content_ratio_threshold": 0.35,
    "maximum_shared_links_on_page": 30,
    "detect_paywall_via_keywords": ["订阅", "付费后可", "VIP专享", "解锁全文", "登录后继续阅读"]
  },
  "citation_rules": {
    "require_source_link_in_candidate": true,
    "evidence_minimum_authority_tier_for_normalized_fact": "official",
    "discovery_tier_must_be_cross_validated": true,
    "unknown_source_authority_override": "discovery"
  },
  "deduplication": {
    "content_hash_algorithm": "sha256",
    "url_canonicalization": [
      {"name": "strip_utm_params", "apply": true},
      {"name": "strip_fragment", "apply": true},
      {"name": "force_https", "apply": true},
      {"name": "strip_tracking_query_params", "apply": true}
    ],
    "reprint_cluster_threshold_jaccard": 0.85,
    "prefer_source_hostname_patterns": [
      "*.gov.cn", "*.cninfo.com.cn", "*.szse.cn", "*.sse.com.cn", "*ir.*.com", "*.caixin.com"
    ]
  }
}
