{
  "$schema_comment": "网页来源注册表：用于 Firecrawl Research Provider 的来源等级治理、白名单、黑名单、抓取频率限制。",
  "version": "1.0.0",
  "updated_at": "2026-07-23",
  "default_authority_tier": "reputable_secondary",
  "maximum_authority_tier_for_unknown": "discovery",
  "global_defaults": {
    "timeout_seconds": 45,
    "max_content_length_chars": 200000,
    "retry_attempts": 2,
    "crawl_delay_seconds": 2,
    "user_agent": "TH-Capital-Research-Bot/1.0 (+https://th-capital.invalid/bot)",
    "save_raw_html": true,
    "save_markdown": true,
    "allow_images": false,
    "allow_javascript_render": true
  },
  "authority_tier_order": ["primary", "official", "reputable_secondary", "discovery"],
  "authority_tier_explanations": {
    "primary": "一手、不可替代的原始披露源（交易所、监管机构、公司官网IR）。用于确定性事实。",
    "official": "官方可公开验证的来源（地方政府、协会官网、券商研报发布主页原文）。",
    "reputable_secondary": "有编辑把关的知名财经/产业媒体（财新、36氪、界面、上证报、证券时报等）。",
    "discovery": "开放式互联网，只能用于线索发现，不能直接作为事实；引用时必须二次核实。"
  },
  "allowed_sites": [
    {
      "hostname_pattern": "*.cninfo.com.cn",
      "site_name": "巨潮资讯网（深交所信息披露）",
      "authority_tier": "official",
      "data_types": ["official_filings", "disclosures"],
      "priority": 90,
      "notes": "正式巨潮 Provider 走官方接口；Firecrawl 只在正文补证时启用。"
    },
    {
      "hostname_pattern": "*.szse.cn",
      "site_name": "深圳证券交易所",
      "authority_tier": "official",
      "data_types": ["official_filings", "rules"],
      "priority": 95
    },
    {
      "hostname_pattern": "*.sse.com.cn",
