# ============================================
# TH Capital 股票研究平台 - 本地环境配置
# ============================================
# 使用说明：
#   1. 复制此文件为 .env（或 .smr_env.local）
#   2. 填入你的 API key 和 base URL
#   3. 保存后重启服务即可生效
# ============================================

# ---------- MiniMax（推荐，Python 脚本默认用这个）----------
# 平台：https://www.minimaxi.com
# API 风格：Anthropic Messages 兼容
MINIMAX_API_KEY=你的_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# ---------- Anthropic（Claude 模型）----------
# 平台：https://www.anthropic.com
ANTHROPIC_API_KEY=你的_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------- OpenAI（可选）----------
# 平台：https://platform.openai.com
OPENAI_API_KEY=你的_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Tavily Search API（必需，用于多维度信息搜索）----------
# 平台：https://tavily.com
# 用途：搜索分析师目标价/评级、业绩纪要、最新动态、海外观点
# 免费额度：每月1000次搜索
TAVILY_API_KEY=你的_tavily_api_key

# ---------- 其他配置（可选）----------
# 默认使用的模型提供商（不填则自动选择第一个可用的）
# SMR_DEFAULT_PROVIDER=minimax

# 模型配置文件路径（一般不用改）
# SMR_MODEL_RUNTIME_DIR=./12_smr_agents/model_runtime
