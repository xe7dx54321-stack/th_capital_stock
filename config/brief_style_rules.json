{
  "brief_type": "internal_watchlist_tracking_brief",
  "style_name": "clear_internal_research_tracking_brief",
  "target_reader": [
    "boss",
    "researcher"
  ],
  "forbidden_styles": [
    "sell_side_research_report",
    "public_marketing_article",
    "investment_recommendation",
    "long_form_industry_report"
  ],
  "required_sections": [
    "executive_brief",
    "analyst_detail",
    "why_not_pending",
    "next_actions"
  ],
  "writing_rules": {
    "start_with_conclusion": true,
    "max_bullets_per_section": 5,
    "max_executive_chars_chinese": 500,
    "avoid_empty_adjectives": true,
    "avoid_ai_tone": true,
    "avoid_sell_side_phrases": true,
    "must_include_tracking_decision": true,
    "must_include_forbidden_actions": true,
    "must_include_boundary": true
  },
  "forbidden_phrases": {
