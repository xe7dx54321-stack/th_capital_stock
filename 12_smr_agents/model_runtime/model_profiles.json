{
  "version": 1,
  "as_of": "2026-04-15",
  "global_mode": "shadow",
  "providers": {
    "openai": {
      "enabled": false,
      "api_key_env": "OPENAI_API_KEY",
      "base_url_env": "OPENAI_BASE_URL",
      "api_style": "responses"
    },
    "minimax": {
      "enabled": true,
      "api_key_env": "MINIMAX_API_KEY",
      "base_url_env": "MINIMAX_BASE_URL",
      "default_base_url": "https://api.minimaxi.com/anthropic",
      "api_style": "anthropic_messages",
      "anthropic_version": "2023-06-01"
    },
    "google": {
      "enabled": false,
      "api_key_env": "GEMINI_API_KEY",
      "base_url_env": "GEMINI_BASE_URL",
      "api_style": "gemini_api"
    },
    "anthropic": {
      "enabled": true,
      "api_key_env": "ANTHROPIC_API_KEY",
      "api_key_env_aliases": [
        "ANTHROPIC_AUTH_TOKEN"
      ],
      "base_url_env": "ANTHROPIC_BASE_URL",
      "api_style": "messages",
      "anthropic_version": "2023-06-01"
    }
  },
  "model_slots": {
    "reasoning_primary": {
      "provider": "minimax",
      "model": "MiniMax-M2.7",
      "reasoning_effort": "high",
      "intended_use": [
        "日报增强",
        "研究压缩",
        "复杂风险解释",
        "治理建议"
      ]
    },
    "reasoning_batch": {
      "provider": "minimax",
      "model": "MiniMax-M2.7",
      "reasoning_effort": "high",
      "intended_use": [
        "批量上下文整理",
        "调度同步候选",
        "中等风险候选块补写"
      ]
    },
    "long_context_secondary": {
      "provider": "minimax",
      "model": "MiniMax-M2.7",
      "reasoning_effort": "medium",
      "intended_use": [
        "超长研究包阅读",
        "跨文件交叉归纳",
        "长上下文对照"
      ]
    },
    "review_second_opinion": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "reasoning_effort": "high",
      "intended_use": [
        "治理复核",
        "review queue 二次意见",
        "争议性结论 second pass"
      ]
    }
  }
}
